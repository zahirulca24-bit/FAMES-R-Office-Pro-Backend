APP_ENV=development
DATABASE_URL=sqlite:///./fames_office.db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
REMEMBER_TOKEN_MINUTES=43200
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=https://fames-r-office-pro-frontend.vercel.app,http://localhost:5173

# One-time bootstrap passwords. Set only for accounts you want to create/update.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_ASSISTANT_DEVELOPER_PASSWORD=
BOOTSTRAP_STUDENT_001_PASSWORD=
BOOTSTRAP_STUDENT_002_PASSWORD=
BOOTSTRAP_STUDENT_003_PASSWORD=
BOOTSTRAP_STUDENT_004_PASSWORD=
BOOTSTRAP_PARTNER_PASSWORD=
BOOTSTRAP_PARTNER_EMAIL=
