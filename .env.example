# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./fames_office.db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=fames-r-office-pro
JWT_AUDIENCE=fames-r-office-pro-frontend
ACCESS_TOKEN_MINUTES=480
REMEMBER_TOKEN_MINUTES=43200
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=https://fames-r-office-pro-frontend.vercel.app,http://localhost:5173

# Bootstrap creates missing users only. Passwords must be supplied through the
# deployment secret store and removed after the intended bootstrap operation.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_ASSISTANT_DEVELOPER_PASSWORD=
BOOTSTRAP_STUDENT_001_PASSWORD=
BOOTSTRAP_STUDENT_002_PASSWORD=
BOOTSTRAP_STUDENT_003_PASSWORD=
BOOTSTRAP_STUDENT_004_PASSWORD=
BOOTSTRAP_PARTNER_PASSWORD=
BOOTSTRAP_PARTNER_EMAIL=

# Emergency Super Admin recovery. Both fields are required. Enable only for a
# single recovery run, then immediately disable/remove them.
BOOTSTRAP_FORCE_RESET=false
BOOTSTRAP_RECOVERY_LOGIN_ID=
